# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=8787
NODE_ENV=production

# Comma-separated list of origins allowed to call this API with credentials
# (your GitHub Pages / custom domain frontend URLs).
ALLOWED_ORIGINS=https://www.alaqai.online,https://alaqai.online,http://localhost:5500,http://127.0.0.1:5500

# Random long secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 32-byte (64 hex chars) key used to encrypt API keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Google OAuth Client ID (Google Cloud Console -> APIs & Services -> Credentials).
# Must match the client ID used by the Google Identity Services button on the frontend.
GOOGLE_CLIENT_ID=

# Comma-separated emails that are automatically granted the top-level "owner"
# role (company leadership) on first sign-in, regardless of what is in the DB.
OWNER_EMAILS=

# How long a new Google sign-in gets a free trial for AI features, in days.
TRIAL_DAYS=7

# Where the SQLite file lives (created automatically). Use a persistent disk
# on your host — this is the only durable storage the app has.
DB_PATH=./data/alaqai.sqlite

# Set to "none" if the API and the frontend are on different top-level domains
# (e.g. api.alaqai.online vs alaqai.online) so the session cookie can be sent
# cross-site. Use "lax" only when frontend and API share the same domain.
COOKIE_SAMESITE=none
